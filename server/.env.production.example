# Production Environment Configuration
# WARNING: Never commit this file to version control!

# PostgreSQL Configuration - Use strong passwords!
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
POSTGRES_USER=catbird
POSTGRES_DB=catbird

# Redis Configuration
REDIS_PASSWORD=REPLACE_WITH_SECURE_REDIS_PASSWORD
REDIS_ENCRYPTION_KEY=base64-encoded-32-byte-key

# Application Configuration
# CRITICAL: Use RUST_LOG=warn in production. Higher levels leak identity metadata.
RUST_LOG=warn
DATABASE_URL=postgresql://catbird:REPLACE_WITH_SECURE_PASSWORD@postgres:5432/catbird
REDIS_URL=redis://:REPLACE_WITH_SECURE_REDIS_PASSWORD@redis:6379

# Server Configuration
SERVER_PORT=3000

# Service DID for inter-service JWT aud validation (required in production)
SERVICE_DID=did:web:mls.example.com

# Sequencer receipts remain disabled until operations publishes the dedicated
# key as did:web:mlschat.catbird.blue#mls-receipt-1 in the edge-served service
# DID document. mls-ds does not own or serve that document.
RECEIPT_ISSUANCE_MODE=disabled
# Phase 1 issue-and-observe configuration (requires the production SERVICE_DID
# to be did:web:mlschat.catbird.blue):
# RECEIPT_ISSUANCE_MODE=issue
# RECEIPT_VERIFICATION_METHOD=did:web:mlschat.catbird.blue#mls-receipt-1
# RECEIPT_SIGNING_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# RECEIPT_SIGNING_KEY_PEM must be distinct from federation SIGNING_KEY_PEM.

# WebSocket subscription ticket signing secret
TICKET_SECRET=REPLACE_WITH_STRONG_TICKET_SECRET

# Authentication — these default to true and MUST stay enabled in production.
# ALLOW_UNSAFE_AUTH is intentionally absent — it is forbidden in production.
# FEDERATION_ALLOW_INSECURE_HTTP is intentionally absent — it is forbidden in production.
ENFORCE_LXM=true
ENFORCE_JTI=true
JTI_TTL_SECONDS=120

# Delivery ACK cleanup worker interval (seconds)
# Default: 86400 (daily)
CLEANUP_INTERVAL_SECS=86400
