# Production Environment Configuration for Catbird MLS Server
# Copy this file to .env in production deployments

# PostgreSQL Configuration
POSTGRES_PASSWORD=replace-with-secure-postgres-password
POSTGRES_USER=catbird
POSTGRES_DB=catbird

# Redis Configuration
REDIS_PASSWORD=replace-with-secure-redis-password
REDIS_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Application Configuration
TICKET_SECRET=replace-with-strong-ticket-secret

# Logging Configuration
RUST_LOG=warn

DATABASE_URL=postgresql://catbird:replace-with-secure-postgres-password@postgres:5432/catbird
TEST_DATABASE_URL=postgresql://catbird:replace-with-secure-postgres-password@postgres:5432/catbird_test
REDIS_URL=redis://:replace-with-secure-redis-password@redis:6379

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# Service DID for inter-service JWT aud validation
SERVICE_DID=did:web:chat.catbird.blue

# Comma-separated canonical DIDs permitted to sign JWTs whose subject differs
# from the issuer. Leave unset for standard AppView deployments.
# TRUSTED_GATEWAY_DIDS=

# Authentication Enforcement
ENFORCE_LXM=true
ENFORCE_JTI=true
JTI_TTL_SECONDS=120

# SSE / Realtime
SSE_BUFFER_SIZE=5000

# Metrics
ENABLE_METRICS=true
METRICS_TOKEN=replace-with-metrics-token

# Federation Core
FEDERATION_ENABLED=false
FEDERATION_MODE=off
RECEIPT_ISSUANCE_MODE=disabled
# RECEIPT_ISSUANCE_MODE=issue
# RECEIPT_VERIFICATION_METHOD=did:web:chat.catbird.blue#mls-receipt-1
# RECEIPT_SIGNING_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# RECEIPT_DID_DOCUMENT_JSON={"id":"did:web:chat.catbird.blue",...}
DEFAULT_DS_ENDPOINT=https://chat.catbird.blue
SELF_ENDPOINT=https://chat.catbird.blue

# Data Retention (Compaction Worker)
MESSAGE_TTL_DAYS=30
EVENT_STREAM_TTL_DAYS=7

# Delivery ACK cleanup worker interval (seconds)
CLEANUP_INTERVAL_SECS=86400

# Key Package Limits (Cleanup Worker)
MAX_KEY_PACKAGES_PER_DEVICE=200

# Rate Limiting Configuration
RATE_LIMIT_IP_PER_MINUTE=60
IP_RATE_BURST=60
RATE_LIMIT_IP_MAX_KEYS=100000
TRUSTED_PROXY_CIDRS=

# Per-DID endpoint-specific rate limiting
RATE_LIMIT_SEND_MESSAGE=100
RATE_LIMIT_PUBLISH_KEY_PACKAGE=20
RATE_LIMIT_ADD_MEMBERS=10
RATE_LIMIT_CREATE_CONVO=5
RATE_LIMIT_REPORT_MEMBER=5
RATE_LIMIT_DID_DEFAULT=200
RATE_LIMIT_DID_MAX_KEYS=300000

# Federation DS peer rate limits
FEDERATION_RATE_LIMIT_DELIVER_MESSAGE=240
FEDERATION_RATE_LIMIT_DELIVER_WELCOME=120
FEDERATION_RATE_LIMIT_SUBMIT_COMMIT=120
FEDERATION_RATE_LIMIT_FETCH_KEY_PACKAGE=120
FEDERATION_RATE_LIMIT_TRANSFER_SEQUENCER=30
FEDERATION_RATE_LIMIT_DEFAULT=180
RATE_LIMIT_FEDERATION_MAX_KEYS=100000

# DID resolution controls
DID_RESOLUTION_TIMEOUT_SECONDS=10

# S3/Blob Storage
S3_ENDPOINT=http://127.0.0.1:8333
S3_ACCESS_KEY=replace-with-s3-access-key
S3_SECRET_KEY=replace-with-s3-secret-key
S3_REGION=us-east-1

# Push Notifications (APNs)
APNS_TOPIC=blue.catbird.app
APNS_PRODUCTION=true
