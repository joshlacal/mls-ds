{
  "lexicon": 1,
  "id": "blue.catbird.chat.relaySpaceCredential",
  "description": "Stateless home-mls-ds relay (3A) exchanging an active registered device's single-use PDS delegation token with a remote Space authority or remote Space host without exposing the client's IP address to third-party servers.",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "actorDeviceId",
            "authorityDid",
            "space",
            "delegationToken"
          ],
          "properties": {
            "actorDeviceId": {
              "type": "ref",
              "ref": "blue.catbird.chat.defs#deviceId"
            },
            "authorityDid": {
              "type": "string",
              "format": "did",
              "description": "DID of the Space authority / host serving com.atproto.space.getSpaceCredential."
            },
            "space": {
              "type": "string",
              "format": "space-ref",
              "maxLength": 512,
              "description": "Canonical at-space:// or at://.../space/... URI."
            },
            "delegationToken": {
              "type": "string",
              "minLength": 16,
              "maxLength": 8192,
              "description": "Single-use PDS delegation JWT bound to the client's ephemeral cnf.jkt / did:key."
            },
            "cnfKey": {
              "type": "string",
              "maxLength": 512,
              "description": "Client ephemeral P-256 did:key for RFC 9421 proof-of-possession."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "credential",
            "expiresAt"
          ],
          "properties": {
            "credential": {
              "type": "string",
              "maxLength": 16384
            },
            "expiresAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "errors": [
        {
          "name": "AccountSessionExpired"
        },
        {
          "name": "CutoverRequired"
        },
        {
          "name": "DeviceNotRegistered"
        },
        {
          "name": "DeviceRevoked"
        },
        {
          "name": "InvalidDelegationToken"
        },
        {
          "name": "InvalidRequest"
        },
        {
          "name": "InvalidTargetEndpoint"
        },
        {
          "name": "NotAuthorized"
        },
        {
          "name": "ProtocolUpgradeRequired"
        },
        {
          "name": "UpstreamError"
        }
      ]
    }
  }
}
