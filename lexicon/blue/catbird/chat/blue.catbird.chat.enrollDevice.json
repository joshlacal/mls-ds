{
  "lexicon": 1,
  "id": "blue.catbird.chat.enrollDevice",
  "description": "Enroll one client-generated MLS device through a standard ATProto service-authenticated AppView request. The canonical Ed25519-signed body binds the authenticated actor DID, device UUID, immutable signing key, generation-zero absence claim, and initial key packages. Existing login is sufficient when its OAuth scope permits this RPC.",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "signedRequest"
          ],
          "properties": {
            "signedRequest": {
              "type": "ref",
              "ref": "blue.catbird.chat.defs#signedDeviceEnrollment"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "device"
          ],
          "properties": {
            "device": {
              "type": "ref",
              "ref": "blue.catbird.chat.defs#deviceView"
            }
          }
        }
      },
      "errors": [
        {
          "name": "AuthenticationGenerationConflict"
        },
        {
          "name": "CutoverRequired"
        },
        {
          "name": "DeviceAlreadyExists"
        },
        {
          "name": "DeviceLimitReached"
        },
        {
          "name": "DeviceTombstoned"
        },
        {
          "name": "IdempotencyConflict"
        },
        {
          "name": "InvalidKeyPackage"
        },
        {
          "name": "InvalidRequest"
        },
        {
          "name": "InvalidSignature"
        },
        {
          "name": "KeyPackageInventoryLimitReached"
        },
        {
          "name": "NotAuthorized"
        },
        {
          "name": "AccountSessionExpired"
        },
        {
          "name": "DeviceBindingMismatch"
        },
        {
          "name": "ProtocolUpgradeRequired"
        },
        {
          "name": "RateLimited"
        }
      ]
    }
  }
}
