{
  "lexicon": 1,
  "id": "blue.catbird.chat.getConversations",
  "description": "The first call creates one opaque retained inventorySession with a single event fence and materialized audience snapshots for active conversation states, device-removal tombstones, terminal close tombstones, pending Welcomes, and recovery inbox. Every page returns the same inventorySessionId, snapshotEventCursor, and expiry. pageCursor is domain-specific, audience/device/session-bound, and never an event cursor; nextPageCursor is absent after the final page. Mixed, expired, or device-mismatched sessions are rejected. Protocol-two scopes bind audience, inventory/page/event cursors and ticket. Unscoped legacy sessions must fail ProtocolUpgradeRequired before any successful partial inventory if unsupported state exists. Omission is never removal evidence.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": [
          "actorDeviceId",
          "limit"
        ],
        "properties": {
          "actorDeviceId": {
            "type": "string",
            "minLength": 36,
            "maxLength": 36,
            "description": "Canonical lowercase hyphenated RFC 4122-variant UUIDv4 device ID; strict runtime validation rejects every other spelling, version, or variant."
          },
          "pageCursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "supportedProtocolVersions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "1",
                "2"
              ]
            },
            "minLength": 1,
            "maxLength": 2
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "items",
            "inventorySessionId",
            "snapshotEventCursor",
            "hasMore",
            "snapshotExpiresAt"
          ],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "blue.catbird.chat.defs#conversationInventoryItem"
              },
              "minLength": 0,
              "maxLength": 100
            },
            "inventorySessionId": {
              "type": "string",
              "minLength": 32,
              "maxLength": 512
            },
            "snapshotEventCursor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "nextPageCursor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "hasMore": {
              "type": "boolean"
            },
            "snapshotExpiresAt": {
              "type": "ref",
              "ref": "blue.catbird.chat.defs#canonicalDatetime"
            },
            "inventoryScope": {
              "type": "ref",
              "ref": "blue.catbird.chat.defs#directRequestInventoryScope"
            }
          }
        }
      },
      "errors": [
        {
          "name": "CursorExpired"
        },
        {
          "name": "CutoverRequired"
        },
        {
          "name": "DeviceNotRegistered"
        },
        {
          "name": "DeviceRevoked"
        },
        {
          "name": "InvalidRequest"
        },
        {
          "name": "AccountSessionExpired"
        },
        {
          "name": "NotAuthorized"
        },
        {
          "name": "DeviceBindingMismatch"
        },
        {
          "name": "ProtocolUpgradeRequired"
        },
        {
          "name": "RateLimited"
        }
      ]
    }
  }
}
