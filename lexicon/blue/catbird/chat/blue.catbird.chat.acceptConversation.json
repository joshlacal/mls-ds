{
  "lexicon": 1,
  "id": "blue.catbird.chat.acceptConversation",
  "description": "Accepts one exact pending invitation from the target participant's active registered device. Under the conversation mutation lock it verifies immutable invitation provenance, consent and every-pair block policy, changes only pending to active at prior stateVersion plus one, and atomically creates one add-kind target-device-signed recovery request with a request-bound KeyPackage reservation. A different current leaf later fulfills the one-device Add Commit and Welcome. Wire protocol 2 directRequestAcceptance is policy-only and never reserves or adds a leaf; accepted devices recover separately. Version 1 keeps its mandatory recovery semantics.",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [],
          "properties": {
            "signedRequest": {
              "type": "ref",
              "ref": "blue.catbird.chat.defs#signedParticipantAcceptance"
            },
            "directRequest": {
              "type": "ref",
              "ref": "blue.catbird.chat.defs#signedDirectRequestAcceptance"
            }
          },
          "description": "Exactly one field is required at runtime; missing, both and unknown fields are rejected before effects. Existing v1 signedRequest bytes remain unchanged."
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "coordinates"
          ],
          "properties": {
            "coordinates": {
              "type": "ref",
              "ref": "blue.catbird.chat.defs#conversationCoordinates"
            },
            "entry": {
              "type": "ref",
              "ref": "blue.catbird.chat.defs#participantAcceptanceEntry"
            },
            "recovery": {
              "type": "ref",
              "ref": "blue.catbird.chat.defs#leafRecoveryView"
            },
            "acceptanceProof": {
              "type": "ref",
              "ref": "blue.catbird.chat.defs#directRequestAcceptanceProof"
            }
          }
        }
      },
      "errors": [
        {
          "name": "BlockedRelationship"
        },
        {
          "name": "ConversationNotFound"
        },
        {
          "name": "CoordinateOverflow"
        },
        {
          "name": "CutoverRequired"
        },
        {
          "name": "DeviceNotRegistered"
        },
        {
          "name": "DeviceRevoked"
        },
        {
          "name": "GroupInvitesDisabled"
        },
        {
          "name": "IdempotencyConflict"
        },
        {
          "name": "InvalidRequest"
        },
        {
          "name": "InvalidSignature"
        },
        {
          "name": "InvitationNotFound"
        },
        {
          "name": "InvitationNotPending"
        },
        {
          "name": "InvitationProvenanceMismatch"
        },
        {
          "name": "KeyPackageUnavailable"
        },
        {
          "name": "MessagesDisabled"
        },
        {
          "name": "NotFollowedByRecipient"
        },
        {
          "name": "NotParticipant"
        },
        {
          "name": "RelationshipPolicyUnavailable"
        },
        {
          "name": "StaleCoordinates"
        },
        {
          "name": "AccountSessionExpired"
        },
        {
          "name": "NotAuthorized"
        },
        {
          "name": "DeviceBindingMismatch"
        },
        {
          "name": "ProtocolUpgradeRequired"
        },
        {
          "name": "RateLimited"
        },
        {
          "name": "CapacityUnavailable",
          "description": "The bounded encrypted request lifecycle reserve cannot accommodate this operation. No first-execution effects are committed; retry the same signed operation after capacity is available."
        }
      ]
    }
  }
}
