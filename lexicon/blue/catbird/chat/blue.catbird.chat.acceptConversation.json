{
  "lexicon": 1,
  "id": "blue.catbird.chat.acceptConversation",
  "description": "Accepts one exact pending invitation from the target participant's active registered device. Under the conversation mutation lock it verifies immutable invitation provenance, consent and every-pair block policy, changes only pending to active at prior stateVersion plus one, and atomically creates one add-kind target-device-signed recovery request with a request-bound KeyPackage reservation. A different current leaf later fulfills the one-device Add Commit and Welcome.",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {"encoding": "application/json", "schema": {"type": "object", "required": ["signedRequest"], "properties": {"signedRequest": {"type": "ref", "ref": "blue.catbird.chat.defs#signedParticipantAcceptance"}}}},
      "output": {"encoding": "application/json", "schema": {"type": "object", "required": ["coordinates", "entry", "recovery"], "properties": {
        "coordinates": {"type": "ref", "ref": "blue.catbird.chat.defs#conversationCoordinates"},
        "entry": {"type": "ref", "ref": "blue.catbird.chat.defs#participantAcceptanceEntry"},
        "recovery": {"type": "ref", "ref": "blue.catbird.chat.defs#leafRecoveryView"}
      }}},
      "errors": [
        {"name": "BlockedRelationship"},
        {"name": "ConversationNotFound"},
        {"name": "CoordinateOverflow"},
        {"name": "CutoverRequired"},
        {"name": "DeviceNotRegistered"},
        {"name": "DeviceRevoked"},
        {"name": "GroupInvitesDisabled"},
        {"name": "IdempotencyConflict"},
        {"name": "InvalidDPoP"},
        {"name": "InvalidRequest"},
        {"name": "InvalidSignature"},
        {"name": "InvitationNotFound"},
        {"name": "InvitationNotPending"},
        {"name": "InvitationProvenanceMismatch"},
        {"name": "KeyPackageUnavailable"},
        {"name": "MessagesDisabled"},
        {"name": "NotFollowedByRecipient"},
        {"name": "NotParticipant"},
        {"name": "RelationshipPolicyUnavailable"},
        {"name": "StaleCoordinates"}
      ]
    }
  }
}
