{
  "lexicon": 1,
  "id": "blue.catbird.chat.registerPushGateway",
  "description": "Registers or clears a device-signed opaque Push Gateway binding (D2, M-F06) for one authenticated MLS device on the user's home mls-ds. mls-ds never sees raw APNs/FCM tokens and never sends push wakes for remote federated users.",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "deviceId",
            "keyId",
            "authGeneration",
            "gatewayUrl",
            "appId",
            "pushKey",
            "signedAt",
            "signature"
          ],
          "properties": {
            "deviceId": {
              "type": "ref",
              "ref": "blue.catbird.chat.defs#deviceId"
            },
            "keyId": {
              "type": "ref",
              "ref": "blue.catbird.chat.defs#keyId"
            },
            "authGeneration": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "gatewayUrl": {
              "type": "string",
              "format": "uri",
              "maxLength": 512,
              "description": "HTTPS endpoint ending in /xrpc/blue.catbird.push.deliver (DNS-pinned SSRF-validated on port 443)."
            },
            "appId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "pushKey": {
              "type": "string",
              "minLength": 0,
              "maxLength": 256,
              "description": "Opaque CSPRNG base64url push routing key issued by the Push Gateway (empty when enabled is false)."
            },
            "enabled": {
              "type": "boolean"
            },
            "signedAt": {
              "type": "ref",
              "ref": "blue.catbird.chat.defs#canonicalDatetime"
            },
            "signature": {
              "type": "bytes",
              "minLength": 64,
              "maxLength": 64
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "registeredAt"
          ],
          "properties": {
            "registeredAt": {
              "type": "ref",
              "ref": "blue.catbird.chat.defs#canonicalDatetime"
            }
          }
        }
      },
      "errors": [
        {
          "name": "AccountSessionExpired"
        },
        {
          "name": "CutoverRequired"
        },
        {
          "name": "DeviceBindingMismatch"
        },
        {
          "name": "DeviceNotRegistered"
        },
        {
          "name": "DeviceRevoked"
        },
        {
          "name": "InvalidGatewayUrl"
        },
        {
          "name": "InvalidRequest"
        },
        {
          "name": "InvalidSignature"
        },
        {
          "name": "NotAuthorized"
        },
        {
          "name": "ProtocolUpgradeRequired"
        }
      ]
    }
  }
}
