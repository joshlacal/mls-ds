{
  "lexicon": 1,
  "id": "blue.catbird.chat.replenishKeyPackages",
  "description": "Publish a whole-or-nothing package batch for the exact active device. The authenticated account, stored immutable key, submitted keyId, auth generation, canonical Ed25519 signature, and package credentials are rechecked under the mutation lock; replenishment does not change auth generation.",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "signedRequest"
          ],
          "properties": {
            "signedRequest": {
              "type": "ref",
              "ref": "blue.catbird.chat.defs#signedKeyPackageReplenishment"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "device"
          ],
          "properties": {
            "device": {
              "type": "ref",
              "ref": "blue.catbird.chat.defs#deviceView"
            }
          }
        }
      },
      "errors": [
        {
          "name": "AuthenticationGenerationConflict"
        },
        {
          "name": "CutoverRequired"
        },
        {
          "name": "DeviceNotRegistered"
        },
        {
          "name": "DeviceRevoked"
        },
        {
          "name": "IdempotencyConflict"
        },
        {
          "name": "InvalidKeyPackage"
        },
        {
          "name": "InvalidRequest"
        },
        {
          "name": "InvalidSignature"
        },
        {
          "name": "KeyPackageInventoryLimitReached"
        },
        {
          "name": "NotAuthorized"
        },
        {
          "name": "AccountSessionExpired"
        },
        {
          "name": "DeviceBindingMismatch"
        },
        {
          "name": "ProtocolUpgradeRequired"
        },
        {
          "name": "RateLimited"
        }
      ]
    }
  }
}
