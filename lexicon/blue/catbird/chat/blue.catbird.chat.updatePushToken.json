{
  "lexicon": 1,
  "id": "blue.catbird.chat.updatePushToken",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Register, rotate or disable a canonical device-signed APNs/FCM push binding. Unsigned token-only input retains legacy registration behavior and never enables encrypted-request notification delivery.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "token": {
              "type": "string",
              "maxLength": 512,
              "description": "Provider token; required with an enabled signed registration, omitted to disable. For signed bindings its SHA256 must equal the signed tokenSha256."
            },
            "registration": {
              "type": "ref",
              "ref": "blue.catbird.chat.defs#signedPushRegistration"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "device"
          ],
          "properties": {
            "device": {
              "type": "ref",
              "ref": "blue.catbird.chat.defs#deviceView"
            },
            "pushBinding": {
              "type": "ref",
              "ref": "blue.catbird.chat.defs#pushRegistrationBinding"
            }
          }
        }
      },
      "errors": [
        {
          "name": "AccountSessionExpired"
        },
        {
          "name": "CutoverRequired"
        },
        {
          "name": "DeviceNotRegistered"
        },
        {
          "name": "DeviceRevoked"
        },
        {
          "name": "InvalidRequest"
        },
        {
          "name": "NotAuthorized"
        },
        {
          "name": "ProtocolUpgradeRequired"
        },
        {
          "name": "RateLimited"
        },
        {
          "name": "InvalidSignature"
        },
        {
          "name": "StaleAuthGeneration"
        },
        {
          "name": "RegistrationConflict"
        },
        {
          "name": "CapacityUnavailable"
        }
      ]
    }
  }
}
