{
  "lexicon": 1,
  "id": "blue.catbird.mlsDS.deliverMessage",
  "description": "Accept an inbound MLS application message from a remote sequencer DS for a local recipient.",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Deliver a federated MLS application message to a local recipient on the destination DS.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "header",
            "entryBytes",
            "signedRequestBytes",
            "recipientDid",
            "entryLocator"
          ],
          "properties": {
            "header": {
              "type": "ref",
              "ref": "blue.catbird.mlsDS.defs#envelopeHeaderV1"
            },
            "entryBytes": {
              "type": "bytes",
              "description": "Canonical DAG-CBOR bytes of the exact applicationEntry"
            },
            "signedRequestBytes": {
              "type": "bytes",
              "description": "Exact JSON bytes of the signed message request"
            },
            "recipientDid": {
              "type": "ref",
              "ref": "blue.catbird.chat.defs#bareDid"
            },
            "entryLocator": {
              "type": "ref",
              "ref": "blue.catbird.mlsDS.defs#entryLocatorV1"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["accepted", "receipt"],
          "properties": {
            "accepted": {
              "type": "boolean",
              "description": "Whether the message was delivered and persisted"
            },
            "receipt": {
              "type": "ref",
              "ref": "blue.catbird.mlsDS.defs#federationReceiptV1"
            }
          }
        }
      },
      "errors": [
        {"name": "MailboxNotProvisioned"},
        {"name": "SequenceConflict"},
        {"name": "DeliveryConflict"},
        {"name": "NotSequencer"},
        {"name": "TermStale"},
        {"name": "InvalidEnvelope"},
        {"name": "UnauthorizedRecipient"}
      ]
    }
  }
}
