{
  "lexicon": 1,
  "id": "blue.catbird.mlsDS.deliverWelcome",
  "description": "Accept and verify an inbound MLS Welcome message from a remote sequencer DS for a preprovisioned local recipient mailbox.",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Deliver a federated MLS Welcome message to complete local preprovisioned participant addition on the destination DS.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "header",
            "recipientDid",
            "recipientDeviceId",
            "welcomeId",
            "recoveryRequestId",
            "keyPackageRef",
            "welcomeBytes",
            "welcomeSha256",
            "entryBytes",
            "signedRequestBytes",
            "entryLocator",
            "coordinates",
            "publicSnapshotSha256",
            "treeSummarySha256"
          ],
          "properties": {
            "header": {
              "type": "ref",
              "ref": "blue.catbird.mlsDS.defs#envelopeHeaderV1"
            },
            "recipientDid": {
              "type": "ref",
              "ref": "blue.catbird.chat.defs#bareDid"
            },
            "recipientDeviceId": {
              "type": "ref",
              "ref": "blue.catbird.chat.defs#deviceId"
            },
            "welcomeId": {
              "type": "ref",
              "ref": "blue.catbird.chat.defs#operationId"
            },
            "recoveryRequestId": {
              "type": "ref",
              "ref": "blue.catbird.chat.defs#operationId"
            },
            "keyPackageRef": {
              "type": "bytes",
              "minLength": 32,
              "maxLength": 32
            },
            "welcomeBytes": {
              "type": "bytes",
              "description": "Serialized MLS Welcome message bytes"
            },
            "welcomeSha256": {
              "type": "bytes",
              "minLength": 32,
              "maxLength": 32
            },
            "entryBytes": {
              "type": "bytes",
              "description": "Canonical DAG-CBOR bytes of the exact control entry"
            },
            "signedRequestBytes": {
              "type": "bytes",
              "description": "Exact JSON bytes of the signed transition request"
            },
            "entryLocator": {
              "type": "ref",
              "ref": "blue.catbird.mlsDS.defs#entryLocatorV1"
            },
            "coordinates": {
              "type": "ref",
              "ref": "blue.catbird.chat.defs#conversationCoordinates"
            },
            "publicSnapshotSha256": {
              "type": "bytes",
              "minLength": 32,
              "maxLength": 32
            },
            "treeSummarySha256": {
              "type": "bytes",
              "minLength": 32,
              "maxLength": 32
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["accepted", "receipt"],
          "properties": {
            "accepted": {
              "type": "boolean",
              "description": "Whether the welcome was accepted and verified against preprovisioned mailbox state"
            },
            "receipt": {
              "type": "ref",
              "ref": "blue.catbird.mlsDS.defs#federationReceiptV1"
            }
          }
        }
      },
      "errors": [
        {"name": "MailboxNotProvisioned"},
        {"name": "DeliveryConflict"},
        {"name": "NotSequencer"},
        {"name": "TermStale"},
        {"name": "InvalidEnvelope"},
        {"name": "UnauthorizedRecipient"}
      ]
    }
  }
}
