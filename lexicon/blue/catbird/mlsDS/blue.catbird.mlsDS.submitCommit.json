{
  "lexicon": 1,
  "id": "blue.catbird.mlsDS.submitCommit",
  "description": "Submit an actor-signed MLS commit to the sequencer DS for canonical transition planning and execution.",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Submit a signed commit transition to the sequencer DS for execution through the canonical submitTransition planner and executor.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "header",
            "signedRequestBytes"
          ],
          "properties": {
            "header": {
              "type": "ref",
              "ref": "blue.catbird.mlsDS.defs#envelopeHeaderV1"
            },
            "signedRequestBytes": {
              "type": "bytes",
              "description": "Exact JSON bytes of the signed commit transition request"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["coordinates", "commitEntry", "welcomes", "receipt"],
          "properties": {
            "coordinates": {
              "type": "ref",
              "ref": "blue.catbird.chat.defs#conversationCoordinates"
            },
            "commitEntry": {
              "type": "ref",
              "ref": "blue.catbird.chat.defs#commitEntry"
            },
            "welcomes": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "blue.catbird.chat.defs#welcomeDeliveryView"
              },
              "minLength": 0,
              "maxLength": 100
            },
            "receipt": {
              "type": "ref",
              "ref": "blue.catbird.mlsDS.defs#federationReceiptV1"
            }
          }
        }
      },
      "errors": [
        {"name": "ConversationNotFound"},
        {"name": "NotSequencer"},
        {"name": "TermStale"},
        {"name": "CommitConflict"},
        {"name": "InvalidEnvelope"},
        {"name": "UnauthorizedParticipantDs"}
      ]
    }
  }
}
