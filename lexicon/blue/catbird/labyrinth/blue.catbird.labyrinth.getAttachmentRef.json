{
  "lexicon": 1,
  "id": "blue.catbird.labyrinth.getAttachmentRef",
  "defs": {
    "main": {
      "type": "query",
      "description": "Look up an attachment reference by blinded index. ORF endpoint ([CB-17]): states are per device of the caller DID; the server never reveals one. Common errors: NotAuthorized, AccountSessionExpired, DeviceRevoked, RateLimited, InvalidRequest, PayloadTooLarge, QuotaExceeded.",
      "parameters": {
        "type": "params",
        "required": [
          "deviceKeyPubkey",
          "blindedIndex"
        ],
        "properties": {
          "deviceKeyPubkey": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "description": "deviceKeyPubkey of the device (lowercase hex)."
          },
          "blindedIndex": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "description": "blinded index (lowercase hex)."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "conversationId",
            "blobId",
            "messageId",
            "tokenMac"
          ],
          "properties": {
            "conversationId": {
              "type": "string",
              "maxLength": 64,
              "description": "Conversation id."
            },
            "blobId": {
              "type": "string",
              "maxLength": 128,
              "description": "chat.blobs id."
            },
            "messageId": {
              "type": "string",
              "maxLength": 256,
              "description": "Message id."
            },
            "tokenMac": {
              "type": "bytes",
              "minLength": 32,
              "maxLength": 32,
              "description": "MAC over the access token."
            }
          }
        }
      },
      "errors": [
        {
          "name": "OrfStateNotFound"
        },
        {
          "name": "NotFound"
        }
      ]
    }
  }
}
