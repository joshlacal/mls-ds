{
  "lexicon": 1,
  "id": "blue.catbird.labyrinth.listOwnerThreads",
  "defs": {
    "main": {
      "type": "query",
      "description": "Lookup by inbox: the threads of the caller's own owner archive (re-archived or delete-for-me history), in the order of each thread's first owner batch. Mailbox endpoint: the caller is a chat device of the mailbox owner. Common errors: NotAuthorized, AccountSessionExpired, DeviceRevoked, RateLimited, InvalidRequest, PayloadTooLarge, QuotaExceeded.",
      "parameters": {
        "type": "params",
        "properties": {
          "cursor": {
            "type": "string",
            "maxLength": 64,
            "description": "Opaque cursor from the previous page."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Page size (at most 100)."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "items"
          ],
          "properties": {
            "items": {
              "type": "array",
              "maxLength": 100,
              "items": {
                "type": "ref",
                "ref": "#threadView"
              }
            },
            "cursor": {
              "type": "string",
              "maxLength": 64,
              "description": "Opaque cursor from the previous page."
            }
          },
          "description": "One page of results."
        }
      }
    },
    "threadView": {
      "type": "object",
      "required": [
        "threadId"
      ],
      "properties": {
        "threadId": {
          "type": "string",
          "maxLength": 256,
          "description": "Thread id."
        }
      }
    }
  }
}
