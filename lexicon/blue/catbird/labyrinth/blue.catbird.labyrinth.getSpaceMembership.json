{
  "lexicon": 1,
  "id": "blue.catbird.labyrinth.getSpaceMembership",
  "defs": {
    "main": {
      "type": "query",
      "description": "Internal Space authority policy lookup. Requires authority service JWT, DS audience, exact lxm, jti and a lifetime of at most 60 seconds. User is the DID from the authority's verified canonical delegation. No user device proof is accepted here. Positive policy must not be cached.",
      "parameters": {"type": "params", "required": ["space", "user"], "properties": {
        "space": {"type": "string", "format": "space-ref"},
        "user": {"type": "string", "format": "did"}
      }},
      "output": {"encoding": "application/json", "schema": {"type": "object", "required": ["space", "generation", "user", "chatGeneration", "chatSeq"], "properties": {
        "space": {"type": "string", "format": "space-ref"},
        "generation": {"type": "string", "minLength": 36, "maxLength": 36},
        "user": {"type": "string", "format": "did"},
        "chatGeneration": {"type": "integer", "minimum": 0},
        "chatSeq": {"type": "integer", "minimum": 0}
      }}},
      "errors": [{"name": "NotParticipant"}, {"name": "NotAuthorized"}, {"name": "SpaceDeleted"}, {"name": "StorageNotConfigured"}]
    }
  }
}
