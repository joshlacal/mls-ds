{
  "lexicon": 1,
  "id": "blue.catbird.labyrinth.getChatDeviceKeys",
  "defs": {
    "main": {
      "type": "query",
      "description": "Every chat device key the DID registered, revoked ones included with their revocation time on the server clock ([CB-27]). Directory endpoint: any authenticated chat device may call it. Common errors: NotAuthorized, AccountSessionExpired, DeviceRevoked, RateLimited, InvalidRequest, PayloadTooLarge, QuotaExceeded.",
      "parameters": {
        "type": "params",
        "required": [
          "did"
        ],
        "properties": {
          "did": {
            "type": "string",
            "format": "did",
            "description": "The account."
          },
          "cursor": {
            "type": "string",
            "maxLength": 64,
            "description": "Opaque cursor from the previous page."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Page size (at most 100)."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "items"
          ],
          "properties": {
            "items": {
              "type": "array",
              "maxLength": 100,
              "items": {
                "type": "ref",
                "ref": "#chatDeviceKey"
              }
            },
            "cursor": {
              "type": "string",
              "maxLength": 64,
              "description": "Opaque cursor from the previous page."
            }
          },
          "description": "One page of results."
        }
      }
    },
    "chatDeviceKey": {
      "type": "object",
      "required": [
        "keyId",
        "signingPublicKey",
        "createdAt"
      ],
      "properties": {
        "keyId": {
          "type": "string",
          "maxLength": 128,
          "description": "chat.device_keys key id."
        },
        "signingPublicKey": {
          "type": "bytes",
          "minLength": 32,
          "maxLength": 32,
          "description": "Ed25519 key."
        },
        "createdAt": {
          "type": "string",
          "format": "datetime",
          "description": "Registration time."
        },
        "revokedAt": {
          "type": "string",
          "format": "datetime",
          "description": "Revocation time."
        }
      }
    }
  }
}
