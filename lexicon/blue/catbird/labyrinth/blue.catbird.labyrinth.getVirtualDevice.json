{
  "lexicon": 1,
  "id": "blue.catbird.labyrinth.getVirtualDevice",
  "defs": {
    "main": {
      "type": "query",
      "description": "One recovery bundle by vdeviceId. Mailbox endpoint: the caller is a chat device of the mailbox owner; every call reads or writes the caller DID's own mailbox. Common errors: NotAuthorized, AccountSessionExpired, DeviceRevoked, RateLimited, InvalidRequest, PayloadTooLarge, QuotaExceeded.",
      "parameters": {
        "type": "params",
        "required": [
          "vdeviceId"
        ],
        "properties": {
          "vdeviceId": {
            "type": "string",
            "minLength": 32,
            "maxLength": 32,
            "description": "vdeviceId (lowercase hex)."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "record"
          ],
          "properties": {
            "record": {
              "type": "unknown",
              "description": "A blue.catbird.labyrinth.virtualDevice record."
            }
          }
        }
      },
      "errors": [
        {
          "name": "VirtualDeviceNotFound"
        }
      ]
    }
  }
}
