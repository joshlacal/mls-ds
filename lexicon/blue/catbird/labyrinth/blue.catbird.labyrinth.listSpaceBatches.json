{
  "lexicon": 1,
  "id": "blue.catbird.labyrinth.listSpaceBatches",
  "defs": {
    "main": {
      "type": "query",
      "description": "List immutable sender record references in the existing conversation server order, subject to current device, participant and MEK recipient authorization. Fetch and verify each referenced Space record and CID before attaching its server order, then apply all supplied redactions. Never reuse references across storage generations.",
      "parameters": {
        "type": "params",
        "required": [
          "threadId",
          "generation",
          "actorDeviceId"
        ],
        "properties": {
          "threadId": {
            "type": "string",
            "maxLength": 256,
            "description": "Conversation id."
          },
          "sender": {
            "type": "string",
            "format": "did",
            "description": "Only this author."
          },
          "fromMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Window start (ms)."
          },
          "untilMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Window end (ms), exclusive."
          },
          "since": {
            "type": "string",
            "format": "datetime",
            "description": "Only records the server received at or after this instant (serverOrder.receivedAt)."
          },
          "until": {
            "type": "string",
            "format": "datetime",
            "description": "Only records the server received before this instant (serverOrder.receivedAt), exclusive."
          },
          "reverse": {
            "type": "boolean",
            "default": false,
            "description": "Newest first: descending server seq. The cursor then continues toward older records."
          },
          "cursor": {
            "type": "string",
            "maxLength": 64,
            "description": "Opaque cursor from the previous page."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Page size (at most 100)."
          },
          "generation": {
            "type": "string",
            "minLength": 36,
            "maxLength": 36,
            "description": "Immutable UUID identifying this conversation storage lifecycle. A recreated Space requires a new generation."
          },
          "actorDeviceId": {
            "type": "string",
            "minLength": 36,
            "maxLength": 36,
            "description": "Current chat device UUID."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "items"
          ],
          "properties": {
            "items": {
              "type": "array",
              "maxLength": 100,
              "items": {
                "type": "ref",
                "ref": "blue.catbird.labyrinth.defs#spaceBatchView"
              }
            },
            "cursor": {
              "type": "string",
              "maxLength": 64,
              "description": "Opaque cursor from the previous page."
            }
          },
          "description": "One page of results."
        }
      },
      "errors": [
        {
          "name": "NotRecipient"
        },
        {
          "name": "StorageGenerationMismatch"
        },
        {
          "name": "StorageNotConfigured"
        },
        {
          "name": "SpaceDeleted"
        }
      ]
    }
  }
}
