{
  "lexicon": 1,
  "id": "blue.catbird.labyrinth.getEpochHead",
  "defs": {
    "main": {
      "type": "query",
      "description": "A DID's recorded epoch head; the latest when epochNumber is absent. Directory endpoint: any authenticated chat device may call it. Common errors: NotAuthorized, AccountSessionExpired, DeviceRevoked, RateLimited, InvalidRequest, PayloadTooLarge, QuotaExceeded.",
      "parameters": {
        "type": "params",
        "required": [
          "did"
        ],
        "properties": {
          "did": {
            "type": "string",
            "format": "did",
            "description": "The account."
          },
          "epochNumber": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1099511627776,
            "description": "Epoch number."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "epoch",
            "receivedAt"
          ],
          "properties": {
            "epoch": {
              "type": "ref",
              "ref": "blue.catbird.labyrinth.defs#epochPublic"
            },
            "receivedAt": {
              "type": "string",
              "format": "datetime",
              "description": "When mls-ds recorded it."
            }
          }
        }
      },
      "errors": [
        {
          "name": "EpochNotFound"
        }
      ]
    }
  }
}
