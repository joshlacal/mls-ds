{
  "lexicon": 1,
  "id": "blue.catbird.labyrinth.findMeks",
  "defs": {
    "main": {
      "type": "query",
      "description": "Every MEK record with this id that the caller wrote or is a recipient of. Thread endpoint on the conversation's sequencer DS; threadId is the chat conversation id ([CB-2]). Common errors: NotAuthorized, AccountSessionExpired, DeviceRevoked, RateLimited, InvalidRequest, PayloadTooLarge, QuotaExceeded. For a thread backed by a conversation Space, a permanently deleted storage generation returns SpaceDeleted without returning data. This is terminal: do not retry by rebinding to another generation or falling back to another storage placement.",
      "parameters": {
        "type": "params",
        "required": [
          "threadId",
          "mekId"
        ],
        "properties": {
          "threadId": {
            "type": "string",
            "maxLength": 256,
            "description": "Conversation id."
          },
          "mekId": {
            "type": "string",
            "minLength": 24,
            "maxLength": 24,
            "description": "mekId (lowercase hex)."
          },
          "cursor": {
            "type": "string",
            "maxLength": 64,
            "description": "Opaque cursor from the previous page."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Page size (at most 100)."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "items"
          ],
          "properties": {
            "items": {
              "type": "array",
              "maxLength": 100,
              "items": {
                "type": "ref",
                "ref": "#authoredView"
              }
            },
            "cursor": {
              "type": "string",
              "maxLength": 64,
              "description": "Opaque cursor from the previous page."
            }
          },
          "description": "One page of results."
        }
      },
      "errors": [
        {
          "name": "NotRecipient"
        },
        {
          "name": "SpaceDeleted",
          "description": "The conversation Space storage generation is permanently deleted."
        }
      ]
    },
    "authoredView": {
      "type": "object",
      "required": [
        "author",
        "rkey",
        "record",
        "order"
      ],
      "properties": {
        "author": {
          "type": "string",
          "format": "did",
          "description": "Author DID."
        },
        "rkey": {
          "type": "string",
          "maxLength": 64,
          "description": "Record key."
        },
        "record": {
          "type": "unknown",
          "description": "The record."
        },
        "order": {
          "type": "ref",
          "ref": "blue.catbird.labyrinth.defs#serverOrder"
        }
      }
    }
  }
}
