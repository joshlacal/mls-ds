{
  "lexicon": 1,
  "id": "blue.catbird.labyrinth.getMemberDevices",
  "defs": {
    "main": {
      "type": "query",
      "description": "The DID's device leaves in one conversation with the chat seqs of the commits that added and removed them (chat.member_devices). Readers bound a key's vouching by them ([CB-27]). Directory endpoint: any authenticated chat device may call it. Common errors: NotAuthorized, AccountSessionExpired, DeviceRevoked, RateLimited, InvalidRequest, PayloadTooLarge, QuotaExceeded.",
      "parameters": {
        "type": "params",
        "required": [
          "threadId",
          "did"
        ],
        "properties": {
          "threadId": {
            "type": "string",
            "maxLength": 256,
            "description": "Conversation id."
          },
          "did": {
            "type": "string",
            "format": "did",
            "description": "The account."
          },
          "cursor": {
            "type": "string",
            "maxLength": 64,
            "description": "Opaque cursor from the previous page."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Page size (at most 100)."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "items"
          ],
          "properties": {
            "items": {
              "type": "array",
              "maxLength": 100,
              "items": {
                "type": "ref",
                "ref": "#memberDevice"
              }
            },
            "cursor": {
              "type": "string",
              "maxLength": 64,
              "description": "Opaque cursor from the previous page."
            }
          },
          "description": "One page of results."
        }
      },
      "errors": [
        {
          "name": "ConversationNotFound"
        }
      ]
    },
    "memberDevice": {
      "type": "object",
      "required": [
        "keyId",
        "signingPublicKey",
        "joinedSeq"
      ],
      "properties": {
        "keyId": {
          "type": "string",
          "maxLength": 128,
          "description": "chat.device_keys key id."
        },
        "signingPublicKey": {
          "type": "bytes",
          "minLength": 32,
          "maxLength": 32,
          "description": "Ed25519 key."
        },
        "joinedSeq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Seq of the commit that added the leaf."
        },
        "removedSeq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Seq of the commit that removed it."
        }
      }
    }
  }
}
