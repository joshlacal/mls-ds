{
  "lexicon": 1,
  "id": "blue.catbird.mlsChatV2.getMessages",
  "description": "Read immutable v2 ciphertext rows in strictly increasing conversation-global seq order. afterSeq is exclusive and never an event cursor.",
  "defs": {"main": {"type": "query", "parameters": {"type": "params", "required": ["conversationId"], "properties": {"conversationId": {"type": "string", "maxLength": 128}, "afterSeq": {"type": "integer", "minimum": 0}, "limit": {"type": "integer", "minimum": 1, "maximum": 200, "default": 100}}}, "output": {"encoding": "application/json", "schema": {"type": "object", "required": ["messages", "nextSeq"], "properties": {"messages": {"type": "array", "items": {"type": "ref", "ref": "blue.catbird.mlsChatV2.defs#messageView"}}, "nextSeq": {"type": "integer", "minimum": 0}}}}, "errors": [{"name": "ConversationNotFound"}, {"name": "NotMember"}]}}
}
